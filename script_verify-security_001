#!/usr/bin/env bash
# detailed-security-check-fixed.sh
# Run as root: sudo /bin/bash detailed-security-check-fixed.sh

set -euo pipefail

IPTABLES="/sbin/iptables"
GREEN="\033[0;32m"
RED="\033[0;31m"
NC="\033[0m" # No Color

if [ "$(id -u)" -ne 0 ]; then
  echo -e "${RED}Run as root: sudo $0${NC}"
  exit 1
fi

echo "========== Detailed Security Checklist =========="

############################################
# 1) Firewall Default Policies
############################################
echo "---- Firewall Default Policies ----"
for chain in INPUT FORWARD OUTPUT; do
  policy=$($IPTABLES -L "$chain" -n | grep "Chain $chain" | awk '{print $4}' | tr -d '()')
  if [[ "$policy" == "DROP" ]]; then
    echo -e "[${GREEN}OK${NC}] $chain policy is DROP"
  else
    echo -e "[${RED}Attention${NC}] $chain policy is $policy (expected DROP)"
  fi
done

############################################
# 2) Firewall Rules
############################################
echo "---- Firewall Rules ----"

# Rules to check: remove "-m tcp" dependency to avoid grep mismatch
RULES=(
  "-A INPUT -p tcp --dport 443 -j ACCEPT"
  "-A OUTPUT -p tcp --dport 443 -j ACCEPT"
  "-A INPUT -p udp --dport 53 -j ACCEPT"
  "-A INPUT -p tcp --dport 53 -j ACCEPT"
  "-A OUTPUT -p udp --dport 53 -j ACCEPT"
  "-A OUTPUT -p tcp --dport 53 -j ACCEPT"
  "-A INPUT -p udp --dport 67:68 -j ACCEPT"
  "-A OUTPUT -p udp --dport 67:68 -j ACCEPT"
  "-A INPUT -p icmp -j ACCEPT"
  "-A OUTPUT -p icmp -j ACCEPT"
)

# Use simplified matching ignoring "-m tcp" differences
EXISTING_RULES=$($IPTABLES -S)
for rule in "${RULES[@]}"; do
  pattern=$(echo "$rule" | sed 's/-A /-A /;s/-p tcp/-p tcp/;s/-p udp/-p udp/')
  if echo "$EXISTING_RULES" | grep -F -- "$pattern" >/dev/null 2>&1; then
    echo -e "[${GREEN}OK${NC}] Rule exists: $rule"
  else
    echo -e "[${RED}Attention${NC}] Rule missing: $rule"
  fi
done

############################################
# 3) Services individually
############################################
echo "---- Services ----"
SERVICES=("avahi-daemon" "cups" "bluetooth" "rpcbind" "ssh")
for svc in "${SERVICES[@]}"; do
  if ! systemctl is-enabled "$svc" >/dev/null 2>&1; then
    echo -e "[${GREEN}OK${NC}] $svc disabled"
  else
    echo -e "[${RED}Attention${NC}] $svc still enabled"
  fi
  if ! systemctl is-active "$svc" >/dev/null 2>&1; then
    echo -e "[${GREEN}OK${NC}] $svc inactive"
  else
    echo -e "[${RED}Attention${NC}] $svc still active"
  fi
done

############################################
# 4) Security Services
############################################
echo "---- Security Services ----"
SEC_SERVICES=("apparmor" "auditd" "fail2ban")
for svc in "${SEC_SERVICES[@]}"; do
  if systemctl is-enabled "$svc" >/dev/null 2>&1; then
    echo -e "[${GREEN}OK${NC}] $svc enabled"
  else
    echo -e "[${RED}Attention${NC}] $svc not enabled"
  fi
  if systemctl is-active "$svc" >/dev/null 2>&1; then
    echo -e "[${GREEN}OK${NC}] $svc active"
  else
    echo -e "[${RED}Attention${NC}] $svc inactive"
  fi
done

############################################
# 5) Kernel Hardening
############################################
echo "---- Kernel Hardening ----"
SYSCTL_FILE="/etc/sysctl.d/99-secure-network.conf"
if [ -f "$SYSCTL_FILE" ]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^# ]] && continue
    [[ -z "$line" ]] && continue
    key=$(echo "$line" | cut -d= -f1 | xargs)
    expected=$(echo "$line" | cut -d= -f2 | xargs)
    # Check if key exists
    if sysctl -a 2>/dev/null | grep -q "^$key"; then
      current=$(sysctl -n "$key" 2>/dev/null)
      if [[ "$current" == "$expected" ]]; then
        echo -e "[${GREEN}OK${NC}] $key = $current"
      else
        echo -e "[${RED}Attention${NC}] $key = $current (expected $expected)"
      fi
    else
      echo -e "[${RED}Attention${NC}] $key not found on this system"
    fi
  done < "$SYSCTL_FILE"
else
  echo -e "[${RED}Attention${NC}] Kernel hardening file $SYSCTL_FILE not found"
fi

############################################
# 6) Automatic Updates
############################################
echo "---- Automatic Updates ----"
AUTO_UPDATES_FILE="/etc/apt/apt.conf.d/20auto-upgrades"
if [ -f "$AUTO_UPDATES_FILE" ]; then
  grep -q 'Unattended-Upgrade "1"' "$AUTO_UPDATES_FILE" && \
    echo -e "[${GREEN}OK${NC}] Automatic security updates enabled" || \
    echo -e "[${RED}Attention${NC}] Automatic security updates not enabled"
else
  echo -e "[${RED}Attention${NC}] File $AUTO_UPDATES_FILE not found"
fi

echo "=============================================="
