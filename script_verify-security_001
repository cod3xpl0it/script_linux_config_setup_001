#!/usr/bin/env bash
# verify-security.sh

set -euo pipefail

# Adiciona /sbin e /usr/sbin ao PATH
export PATH=$PATH:/sbin:/usr/sbin

GREEN="\e[32m"
RED="\e[31m"
RESET="\e[0m"

check() {
  if "$@" >/dev/null 2>&1; then
    echo -e "${GREEN}[OK]${RESET} $*"
  else
    echo -e "${RED}[FAIL]${RESET} $*"
  fi
}

echo -e "\n🔍 Checking system security status...\n"

############################################
# Firewall check (iptables)
############################################
echo "🔥 Checking iptables firewall..."

if command -v iptables >/dev/null 2>&1; then
    echo -e "${GREEN}[OK]${RESET} iptables found at $(command -v iptables)"
else
    echo -e "${RED}[FAIL]${RESET} iptables not found"
fi

# Não precisa usar sudo, já é root
DEFAULT_INPUT=$(iptables -L INPUT -n | grep "Chain INPUT" | awk '{print $4}')
DEFAULT_OUTPUT=$(iptables -L OUTPUT -n | grep "Chain OUTPUT" | awk '{print $4}')
DEFAULT_FORWARD=$(iptables -L FORWARD -n | grep "Chain FORWARD" | awk '{print $4}')

echo "Default policies: INPUT=$DEFAULT_INPUT OUTPUT=$DEFAULT_OUTPUT FORWARD=$DEFAULT_FORWARD"
if [[ "$DEFAULT_INPUT" == "DROP" && "$DEFAULT_OUTPUT" == "DROP" && "$DEFAULT_FORWARD" == "DROP" ]]; then
  echo -e "${GREEN}[OK]${RESET} Default DROP policies in place"
else
  echo -e "${RED}[WARN]${RESET} Default policies not DROP (less secure)"
fi
