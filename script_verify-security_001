#!/usr/bin/env bash
# verify-security-minimal.sh
# Run as root: sudo bash verify-security-minimal.sh

set -euo pipefail

GREEN="\033[0;32m"
RED="\033[0;31m"
NC="\033[0m"

log_ok()   { echo -e "[${GREEN}OK${NC}] $1"; }
log_warn() { echo -e "[${RED}Attention${NC}] $1"; }

if [ "$(id -u)" -ne 0 ]; then
    echo "Run as root: sudo $0"
    exit 1
fi

IPTABLES=$(command -v iptables)
SYSTEMCTL=$(command -v systemctl)
SYSCTL=$(command -v sysctl)

echo "===== Minimal Security Verification ====="

############################################
# 1) Firewall default policies
############################################
echo "---- Firewall Default Policies ----"
for chain in INPUT FORWARD OUTPUT; do
    policy=$($IPTABLES -L "$chain" -n | grep "Chain $chain" | awk '{print $4}' | tr -d '()')
    if [[ "$policy" == "DROP" ]]; then
        log_ok "$chain policy is DROP"
    else
        log_warn "$chain policy is $policy (expected DROP)"
    fi
done

# Check essential rules
echo "---- Firewall Rules ----"
RULES=(
    "tcp dpt:443"   # HTTPS
    "tcp dpt:53"    # DNS
    "udp dpt:53"    # DNS
    "udp dpt:67:68" # DHCP
    "icmp"          # ICMP
)

EXISTING_RULES=$($IPTABLES -S)
for rule in "${RULES[@]}"; do
    if echo "$EXISTING_RULES" | grep -F -- "$rule" >/dev/null 2>&1; then
        log_ok "Rule exists: $rule"
    else
        log_warn "Rule missing: $rule"
    fi
done

############################################
# 2) Unnecessary services
############################################
echo "---- Disabled/Removed Services ----"
SERVICES=("avahi-daemon" "cups" "bluetooth" "rpcbind" "ssh")
for svc in "${SERVICES[@]}"; do
    if ! $SYSTEMCTL is-active "$svc" >/dev/null 2>&1; then
        log_ok "$svc inactive"
    else
        log_warn "$svc still active"
    fi
done

############################################
# 3) Security services
############################################
echo "---- Security Services ----"
SEC_SERVICES=("apparmor" "auditd" "fail2ban")
for svc in "${SEC_SERVICES[@]}"; do
    if $SYSTEMCTL is-active "$svc" >/dev/null 2>&1; then
        log_ok "$svc active"
    else
        log_warn "$svc inactive"
    fi
done

############################################
# 4) Automatic updates
############################################
echo "---- Automatic Security Updates ----"
AUTO_FILE="/etc/apt/apt.conf.d/20auto-upgrades"
if [ -f "$AUTO_FILE" ] && grep -q 'Unattended-Upgrade "1"' "$AUTO_FILE"; then
    log_ok "Automatic security updates enabled"
else
    log_warn "Automatic security updates not enabled"
fi

############################################
# 5) Kernel hardening
############################################
echo "---- Kernel Hardening ----"
SYSCTL_FILE="/etc/sysctl.d/99-secure-network.conf"
if [ -f "$SYSCTL_FILE" ]; then
    MISSING=0
    for key in net.ipv4.conf.all.accept_redirects \
               net.ipv4.conf.all.send_redirects \
               net.ipv4.conf.default.accept_redirects \
               net.ipv4.conf.default.send_redirects \
               net.ipv4.conf.all.accept_source_route \
               net.ipv6.conf.all.accept_source_route \
               net.ipv4.tcp_syncookies \
               net.ipv4.conf.all.rp_filter; do
        expected=$(grep "^$key" "$SYSCTL_FILE" | cut -d= -f2 | xargs)
        current=$($SYSCTL -n "$key" 2>/dev/null || echo "missing")
        if [[ "$current" == "$expected" ]]; then
            log_ok "$key = $current"
        else
            log_warn "$key = $current (expected $expected)"
            MISSING=1
        fi
    done
    [[ $MISSING -eq 0 ]] && echo "All kernel hardening settings correct."
else
    log_warn "Kernel hardening file $SYSCTL_FILE not found"
fi

echo "===== Verification Complete ====="
