#!/bin/bash
# Reset firewalld to its factory default state
# Must be run as root

echo "Resetting firewalld to factory defaults..."

# Check if firewalld is installed
if ! command -v firewall-cmd &> /dev/null; then
  echo "Error: firewalld is not installed on this system."
  exit 1
fi

# Stop firewalld service
echo "Stopping firewalld..."
systemctl stop firewalld

# Remove all persistent configurations
echo "Removing firewalld configuration files..."
rm -rf /etc/firewalld

# Start firewalld again
echo "Starting firewalld..."
systemctl start firewalld

# Reload configuration
echo "Reloading firewalld..."
firewall-cmd --reload > /dev/null 2>&1

# Display the default configuration
echo "Current firewalld configuration:"
firewall-cmd --list-all

echo "Firewalld has been successfully reset to default settings!"
