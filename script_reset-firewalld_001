#!/bin/bash
# Reset firewalld and iptables to factory default state
# Must be run as root

echo "======================================="
echo " Resetting firewalld and iptables..."
echo "======================================="

#---------------------------------------
# Check firewalld
#---------------------------------------
if command -v firewall-cmd &> /dev/null; then
  echo "Stopping firewalld..."
  systemctl stop firewalld

  echo "Removing firewalld configuration files..."
  rm -rf /etc/firewalld

  echo "Starting firewalld..."
  systemctl start firewalld

  echo "Reloading firewalld..."
  firewall-cmd --reload > /dev/null 2>&1

  echo "Current firewalld configuration:"
  firewall-cmd --list-all
else
  echo "Warning: firewalld not found, skipping..."
fi

#---------------------------------------
# Reset iptables (IPv4)
#---------------------------------------
if command -v iptables &> /dev/null; then
  echo "Resetting iptables rules (IPv4)..."
  iptables -F
  iptables -X
  iptables -Z
  iptables -P INPUT ACCEPT
  iptables -P FORWARD ACCEPT
  iptables -P OUTPUT ACCEPT
else
  echo "Warning: iptables not found, skipping..."
fi

#---------------------------------------
# Reset ip6tables (IPv6)
#---------------------------------------
if command -v ip6tables &> /dev/null; then
  echo "Resetting ip6tables rules (IPv6)..."
  ip6tables -F
  ip6tables -X
  ip6tables -Z
  ip6tables -P INPUT ACCEPT
  ip6tables -P FORWARD ACCEPT
  ip6tables -P OUTPUT ACCEPT
else
  echo "Warning: ip6tables not found, skipping..."
fi

#---------------------------------------
# Optional: Save the reset state (if supported)
#---------------------------------------
if command -v netfilter-persistent &> /dev/null; then
  echo "Saving current firewall state..."
  netfilter-persistent save
fi

echo "======================================="
echo " Firewall reset complete!"
echo " Both firewalld and iptables restored to defaults."
echo "======================================="
