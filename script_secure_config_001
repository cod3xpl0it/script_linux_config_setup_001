#!/usr/bin/env bash
# secure-minimal-iptables-forcando-sbin.sh
# Run as root: sudo bash $0

set -euo pipefail

find_cmd() {
  local cmd="$1"
  if [ -x "/sbin/$cmd" ]; then
    printf "%s" "/sbin/$cmd"
    return 0
  fi
  if [ -x "/usr/sbin/$cmd" ]; then
    printf "%s" "/usr/sbin/$cmd"
    return 0
  fi
  if command -v "$cmd" >/dev/null 2>&1; then
    command -v "$cmd"
    return 0
  fi
  return 1
}

log() { echo -e "[*] $*"; }

if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root. Example: sudo bash $0"
  exit 1
fi

IPTABLES=$(find_cmd iptables) || { echo "iptables not found"; exit 1; }
NETFILTER_PERSISTENT=$(find_cmd netfilter-persistent) || true
APT=$(find_cmd apt) || { echo "apt not found"; exit 1; }
SYSTEMCTL=$(find_cmd systemctl) || { echo "systemctl not found"; exit 1; }
SYSCTL=$(find_cmd sysctl) || { echo "sysctl not found"; exit 1; }
REBOOT_CMD=$(find_cmd reboot) || true
CURL=$(find_cmd curl) || true
NMAP=$(find_cmd nmap) || true

export PATH=/sbin:/usr/sbin:$PATH

log "Updating system and installing security tools..."
export DEBIAN_FRONTEND=noninteractive
"$APT" update -y
"$APT" upgrade -y
"$APT" install -y --no-install-recommends unattended-upgrades apt-listchanges auditd fail2ban apparmor apparmor-utils bash-completion curl nmap iproute2 procps iptables

log "Configuring iptables firewall..."
"$IPTABLES" -F
"$IPTABLES" -X
"$IPTABLES" -t nat -F
"$IPTABLES" -t nat -X
"$IPTABLES" -t mangle -F
"$IPTABLES" -t mangle -X
"$IPTABLES" -t raw -F
"$IPTABLES" -t raw -X
"$IPTABLES" -P INPUT DROP
"$IPTABLES" -P FORWARD DROP
"$IPTABLES" -P OUTPUT DROP
"$IPTABLES" -A INPUT -i lo -j ACCEPT
"$IPTABLES" -A OUTPUT -o lo -j ACCEPT
"$IPTABLES" -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
"$IPTABLES" -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
"$IPTABLES" -A INPUT -p icmp -j ACCEPT
"$IPTABLES" -A OUTPUT -p icmp -j ACCEPT
"$IPTABLES" -A INPUT -p udp --dport 53 -j ACCEPT
"$IPTABLES" -A INPUT -p tcp --dport 53 -j ACCEPT
"$IPTABLES" -A OUTPUT -p udp --dport 53 -j ACCEPT
"$IPTABLES" -A OUTPUT -p tcp --dport 53 -j ACCEPT
"$IPTABLES" -A INPUT -p udp --dport 67:68 -j ACCEPT
"$IPTABLES" -A OUTPUT -p udp --dport 67:68 -j ACCEPT
"$IPTABLES" -A INPUT -p tcp --dport 443 -j ACCEPT
"$IPTABLES" -A OUTPUT -p tcp --dport 443 -j ACCEPT

# Pergunta se quer bloquear HTTP
read -rp "Deseja bloquear HTTP (porta 80)? (y/N): " BLOCK_HTTP
if [[ "${BLOCK_HTTP}" =~ ^[yY]$ ]]; then
    "$IPTABLES" -A INPUT -p tcp --dport 80 -j REJECT
    "$IPTABLES" -A OUTPUT -p tcp --dport 80 -j REJECT
    log "HTTP bloqueado."
else
    "$IPTABLES" -A INPUT -p tcp --dport 80 -j ACCEPT
    "$IPTABLES" -A OUTPUT -p tcp --dport 80 -j ACCEPT
    log "HTTP permitido."
fi

if [ -n "${NETFILTER_PERSISTENT:-}" ] && "$NETFILTER_PERSISTENT" --version >/dev/null 2>&1; then
    "$NETFILTER_PERSISTENT" save || true
else
    "$APT" install -y netfilter-persistent
    NETFILTER_PERSISTENT=$(find_cmd netfilter-persistent) || true
    [ -n "${NETFILTER_PERSISTENT:-}" ] && "$NETFILTER_PERSISTENT" save || true
fi

log "iptables rules applied:"
"$IPTABLES" -L -v --line-numbers

log "Disabling and removing unnecessary services..."
for svc in avahi-daemon cups bluetooth rpcbind ssh; do
  "$SYSTEMCTL" disable --now "$svc" 2>/dev/null || true
done

"$APT" purge -y avahi-daemon cups telnet ftp rpcbind openssh-server || true
"$APT" autoremove -y
"$APT" autoclean -y

log "Enabling automatic security updates..."
cat >/etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

distro_id="Debian"
distro_codename="stable"
[ -f /etc/os-release ] && . /etc/os-release && distro_id=${ID:-$distro_id} && distro_codename=${VERSION_CODENAME:-$distro_codename}

cat >/etc/apt/apt.conf.d/50unattended-upgrades <<EOF
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-security";
};
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
EOF

"$SYSTEMCTL" enable --now unattended-upgrades || true

log "Enabling AppArmor..."
"$SYSTEMCTL" enable --now apparmor || true
log "Enabling auditd..."
"$SYSTEMCTL" enable --now auditd || true
log "Enabling fail2ban..."
"$SYSTEMCTL" enable --now fail2ban || true

cat >/etc/fail2ban/jail.d/local.conf <<'EOF'
[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 5
EOF

"$SYSTEMCTL" restart fail2ban || true

log "Applying kernel hardening..."
cat >/etc/sysctl.d/99-secure-network.conf <<'EOF'
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
EOF

"$SYSCTL" --system >/dev/null || true

log "System hardening complete!"
echo "- Firewall: blocks all exceto HTTPS (443), DNS (53), DHCP (67/68) e ICMP"
echo "- HTTP: $( [[ "${BLOCK_HTTP}" =~ ^[yY]$ ]] && echo "bloqueado" || echo "permitido" )"
echo "- SSH: disabled/removed"
echo "- Automatic security updates enabled"
echo "- AppArmor, auditd, and fail2ban active"
echo "- Extra services disabled"

read -rp "Reboot now? (y/N): " REBOOT
if [[ "${REBOOT}" =~ ^[yY]$ ]]; then
  if [ -n "${REBOOT_CMD:-}" ]; then
    "$REBOOT_CMD"
  else
    "$SYSTEMCTL" reboot || true
  fi
else
  echo "Reboot later to apply all changes fully."
fi
