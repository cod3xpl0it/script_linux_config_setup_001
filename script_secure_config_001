#!/bin/bash
# Run as root - Ultra-secure hardening for Debian minimal (NO REMOTE ACCESS) - Fail2ban FIXED + DNS RESTRICTED + APT JAIL + AUTO-REBOOT
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# -----------------------------
# IPv6 OPTIONAL: uncomment to ENABLE secure IPv6 (Google DNS + HTTP/HTTPS only)
ENABLE_IPV6=false
#ENABLE_IPV6=true

# Colors
GREEN="\033[0;32m" YELLOW="\033[1;33m" RED="\033[0;31m" NC="\033[0m"

echo -e "${GREEN} Starting ULTRA-SECURE hardening (NO REMOTE ACCESS + INSTANT REBOOT)...${NC}"
echo -e "${RED}  SSH will be DISABLED forever!${NC}"
echo -e "${YELLOW} Use physical console/KVM only.${NC}"
echo -e "${RED} AUTO-REBOOT immediately after kernel patches!${NC}"
read -p "Continue? (Y/N): " -n 1 -r
echo
[[ ! $REPLY =~ ^[Yy]$ ]] && { echo "Aborted."; exit 1; }

# -----------------------------
# 1) Update + essential packages
echo -e "${GREEN} Updating system...${NC}"
apt update -y && apt upgrade -y && apt dist-upgrade -y

# 2) Security tools + unattended-upgrades for APT jail
echo -e "${GREEN} Installing security tools...${NC}"
apt install -y nftables apt-listchanges auditd fail2ban apparmor \
apparmor-utils bash-completion curl nmap iproute2 procps unattended-upgrades

# -----------------------------
# 3) SECURE NFTABLES + VALIDATED FLUSH
echo -e "${GREEN} SAFE nftables setup (validated flush)...${NC}"

# MULTIPLE BACKUPS (pre-hardening state)
cp -f /etc/nftables.conf /etc/nftables.conf.bak 2>/dev/null || true
nft list ruleset > /etc/nftables.conf.pre-hardening 2>/dev/null || true
cp /etc/nftables.conf.pre-hardening /root/nftables-restore-emergency  # Extra safe copy

# SAFE FLUSH: Check if rules exist first, then flush safely
if nft list ruleset >/dev/null 2>&1; then
    echo -e "${YELLOW} Active rules detected, flushing safely...${NC}"
    nft flush ruleset
else
    echo -e "${GREEN} No active rules, clean slate.${NC}"
fi

# Main firewall (priority 0)
nft add table inet filter
nft add chain inet filter input { type filter hook input priority 0 \; policy drop \; }
nft add chain inet filter forward { type filter hook forward priority 0 \; policy drop \; }
nft add chain inet filter output { type filter hook output priority 0 \; policy accept \; }

# Essential rules
nft add rule inet filter input iif lo accept
nft add rule inet filter output oif lo accept
nft add rule inet filter input ct state invalid drop
nft add rule inet filter input ct state established,related accept
nft add rule inet filter output ct state established,related accept
nft add rule inet filter input ip protocol icmp accept
nft add rule inet filter output ip protocol icmp accept

# DNS SECURE: Google only (IPv4)
nft add rule inet filter output udp dport 53 ip daddr {8.8.8.8, 8.8.4.4} accept
nft add rule inet filter output tcp dport 53 ip daddr {8.8.8.8, 8.8.4.4} accept

# HTTP/HTTPS output only
nft add rule inet filter output tcp dport {80, 443} accept

# IPv6 (if enabled)
if [[ "$ENABLE_IPV6" == "true" ]]; then
    echo -e "${GREEN} IPv6 ENABLED (Google DNS + HTTP/HTTPS)${NC}"
    nft add rule inet filter output udp dport 53 ip6 daddr {2001:4860:4860::8888, 2001:4860:4860::8844} accept
    nft add rule inet filter output tcp dport 53 ip6 daddr {2001:4860:4860::8888, 2001:4860:4860::8844} accept
    nft add rule inet filter output tcp dport {80, 443} ip6 daddr accept
    nft add rule inet filter input ip6 nexthdr icmpv6 icmpv6 type {destination-unreachable, packet-too-big, time-exceeded, parameter-problem, echo-request, echo-reply, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert} accept
    nft add rule inet filter output ip6 nexthdr icmpv6 accept
else
    echo -e "${YELLOW} IPv6 DISABLED${NC}"
fi

# Save + enable
nft list ruleset > /etc/nftables.conf
nft -f /etc/nftables.conf  # Validate load
systemctl enable --now nftables

# -----------------------------
# 4) DNS SECURE via /etc/resolv.conf (FIXED: NO systemd-resolved)
echo -e "${GREEN} Google DNS via /etc/resolv.conf (minimal safe)...${NC}"
rm -f /etc/resolv.conf
cat > /etc/resolv.conf << 'EOF'
nameserver 8.8.8.8
nameserver 8.8.4.4
EOF
chmod 644 /etc/resolv.conf

# -----------------------------
# 5) FAIL2BAN DEDICATED TABLE + APT + RECIDIVE JAILS (FIXED: priority 10)
echo -e "${GREEN} Fail2ban: DEDICATED table (priority 10) + APT + recidive${NC}"

mkdir -p /etc/nftables.d

# Fail2ban table (FIXED: priority 10 = AFTER established/related rules)
cat > /etc/nftables.d/fail2ban.conf << 'EOF'
table inet fail2ban {
    chain input {
        type filter hook input priority 10; policy accept;
    }
}
EOF

# Include in main config
grep -q "include.*nftables.d" /etc/nftables.conf || echo 'include "/etc/nftables.d/*.conf"' >> /etc/nftables.conf
nft -f /etc/nftables.conf  # Reload + validate

# Fail2ban nftables action
cat > /etc/fail2ban/action.d/nftables-common.local << 'EOF'
[Init]
nftables_family = ip
nftables_table = fail2ban
blocktype = reject
nftables_set_prefix =
EOF

# FIXED: APT + recidive jails
cat > /etc/fail2ban/jail.local << 'EOF'
[DEFAULT]
banaction = nftables-multiport
banaction_allports = nftables-allports
chain = input
backend = systemd
bantime = 24h
findtime = 600
maxretry = 3
ignoreip = 127.0.0.1/8 ::1/128
allowipv6 = auto

[apt]
enabled = true
logpath = /var/log/apt/history.log
banaction = nftables-multiport

[recidive]
enabled = true
logpath = /var/log/fail2ban.log
banaction = nftables-allports
EOF

systemctl enable --now fail2ban
fail2ban-client reload

# -----------------------------
# 6) Unattended-upgrades (INSTANT REBOOT after kernel patches)
echo -e "${GREEN} Enabling unattended-upgrades with INSTANT REBOOT...${NC}"
cat > /etc/apt/apt.conf.d/50unattended-upgrades << 'EOF'
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}:${distro_codename}-updates";
};
Unattended-Upgrade::Mail "root";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "01:00";
Unattended-Upgrade::Reboot-When-Finished "true";
EOF

systemctl enable --now unattended-upgrades

# -----------------------------
# 6.1) Custom Timers: 1MIN BOOT + 2H (EXACT user request)
echo -e "${GREEN} Custom timers: 1min BOOT + 2h intervals...${NC}"

# Download lists: 30s boot + 2h
mkdir -p /etc/systemd/system/apt-daily.timer.d
cat > /etc/systemd/system/apt-daily.timer.d/override.conf << 'EOF'
[Timer]
OnBootSec=30s
OnUnitActiveSec=2h
RandomizedDelaySec=5min
Persistent=false
EOF

# Install upgrades: 1min boot + 2h
mkdir -p /etc/systemd/system/apt-daily-upgrade.timer.d
cat > /etc/systemd/system/apt-daily-upgrade.timer.d/override.conf << 'EOF'
[Timer]
OnBootSec=1min
OnUnitActiveSec=2h
RandomizedDelaySec=10min
Persistent=false
EOF

# APT protections
cat > /etc/apt/apt.conf.d/99-safe-updates << 'EOF'
DPkg::Lock::Timeout "60s";
Acquire::Retries "3";
Acquire::http::Dl-Limit "500";
EOF

systemctl daemon-reload
systemctl restart apt-daily.timer apt-daily-upgrade.timer

# -----------------------------
# 7) NO REMOTE ACCESS
echo -e "${GREEN} Blocking ALL remote services...${NC}"
systemctl disable --now avahi-daemon cups bluetooth rpcbind ssh sshd openssh-server 2>/dev/null || true
systemctl mask ssh sshd openssh-server 2>/dev/null || true

apt purge -y avahi-daemon cups telnet ftp rpcbind openssh-server || true
apt autoremove -y && apt autoclean -y

# -----------------------------
# 8) Kernel hardening
echo -e "${GREEN} Kernel network protection...${NC}"
cat > /etc/sysctl.d/99-secure-network.conf << 'EOF'
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv4.tcp_syncookies = 1
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv6.conf.all.rp_filter = 1
EOF

[[ "$ENABLE_IPV6" != "true" ]] && cat >> /etc/sysctl.d/99-secure-network.conf << 'EOF'
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
EOF

sysctl --system

# -----------------------------
# 9) POST-HARDENING BACKUP & STATUS
nft list ruleset > /etc/nftables.conf.post-hardening
cp /etc/nftables.conf.post-hardening /root/nftables-post-hardening

echo -e "${GREEN} ULTRA-SECURE HARDENING + INSTANT REBOOT COMPLETED!${NC}"
echo -e "${RED} SSH: DELETED + MASKED${NC}"
echo -e "${GREEN} FINAL STATUS:${NC}"
echo "  • Fail2ban: APT + recidive jails (dedicated table prio 10 FIXED)"
echo "  • DNS: Google 8.8.8.8/8.8.4.4 via /etc/resolv.conf (systemd-resolved REMOVED FIXED)"
echo "  • Firewall: BLOCK ALL inbound, HTTP/HTTPS out only"
echo "  • Updates: 1min BOOT + 2h intervals + INSTANT REBOOT on kernel"
echo -e "${YELLOW} Backups:${NC}"
echo "  • /etc/nftables.conf.pre-hardening (EMERGENCY RESTORE)"
echo "  • /root/nftables-restore-emergency"
echo "  • /etc/nftables.conf.post-hardening"
echo -e "${RED}  EMERGENCY: nft -f /etc/nftables.conf.pre-hardening${NC}"
echo -e "${GREEN} Post-reboot tests:${NC}"
echo "  • apt update"
echo "  • fail2ban-client status apt recidive"
echo "  • nft list table inet fail2ban"
echo "  • cat /etc/resolv.conf"
echo "  • systemctl status apt-daily-upgrade.timer"
echo "  • journalctl -u unattended-upgrades | tail"
echo -e "${RED} Reboot required (console only)!${NC}"
echo -e "${GREEN} ULTRA-SECURE SYSTEM READY!${NC}"
