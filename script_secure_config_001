#!/bin/bash

# Update the system
echo "Updating the system..."
apt update -y
apt upgrade -y

# Install essential tools
echo "Installing essential tools..."
apt install -y iptables netfilter-persistent sysvinit-utils \
unattended-upgrades apt-listchanges auditd fail2ban apparmor \
apparmor-utils bash-completion curl nmap iproute2 procps

# Configure the firewall (iptables)
echo "Configuring the firewall..."

# Clear old iptables rules
iptables -F
iptables -X
iptables -t nat -F
iptables -t mangle -F
iptables -t raw -F

# Set default policies to DROP
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT DROP

# Allow loopback traffic (localhost)
iptables -A INPUT -i lo -j ACCEPT
iptables -A OUTPUT -o lo -j ACCEPT

# Allow established connections
iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Allow ICMP (ping)
iptables -A INPUT -p icmp -j ACCEPT
iptables -A OUTPUT -p icmp -j ACCEPT

# Allow DNS (port 53 UDP/TCP)
iptables -A INPUT -p udp --dport 53 -j ACCEPT
iptables -A INPUT -p tcp --dport 53 -j ACCEPT
iptables -A OUTPUT -p udp --dport 53 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 53 -j ACCEPT

# Allow DHCP (ports 67-68 UDP)
iptables -A INPUT -p udp --dport 67:68 -j ACCEPT
iptables -A OUTPUT -p udp --dport 67:68 -j ACCEPT

# Allow HTTP (port 80)
iptables -A INPUT -p tcp --dport 80 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 80 -j ACCEPT

# Allow HTTPS (port 443)
iptables -A INPUT -p tcp --dport 443 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 443 -j ACCEPT

# Save iptables rules
netfilter-persistent save

# Disable unnecessary services
echo "Disabling unnecessary services..."
systemctl disable --now avahi-daemon cups bluetooth rpcbind ssh

# Remove unnecessary packages
apt purge -y avahi-daemon cups telnet ftp rpcbind openssh-server
apt autoremove -y
apt autoclean -y

# Enable automatic updates
echo "Configuring automatic updates..."

# Periodic update configuration
echo 'APT::Periodic::Update-Package-Lists "1";' > /etc/apt/apt.conf.d/20auto-upgrades
echo 'APT::Periodic::Unattended-Upgrade "1";' >> /etc/apt/apt.conf.d/20auto-upgrades

# Allow only security updates
echo 'Unattended-Upgrade::Allowed-Origins {' > /etc/apt/apt.conf.d/50unattended-upgrades
echo '    "Debian:stable-security";' >> /etc/apt/apt.conf.d/50unattended-upgrades
echo '};' >> /etc/apt/apt.conf.d/50unattended-upgrades
echo 'Unattended-Upgrade::Automatic-Reboot "false";' >> /etc/apt/apt.conf.d/50unattended-upgrades
echo 'Unattended-Upgrade::Remove-Unused-Dependencies "true";' >> /etc/apt/apt.conf.d/50unattended-upgrades

# Enable the automatic updates service
systemctl enable --now unattended-upgrades

# Apply kernel hardening
echo "Applying kernel hardening..."

# Kernel security configurations
echo 'net.ipv4.conf.all.accept_redirects = 0' > /etc/sysctl.d/99-secure-network.conf
echo 'net.ipv4.conf.all.send_redirects = 0' >> /etc/sysctl.d/99-secure-network.conf
echo 'net.ipv4.conf.default.accept_redirects = 0' >> /etc/sysctl.d/99-secure-network.conf
echo 'net.ipv4.conf.default.send_redirects = 0' >> /etc/sysctl.d/99-secure-network.conf
echo 'net.ipv4.conf.all.accept_source_route = 0' >> /etc/sysctl.d/99-secure-network.conf
echo 'net.ipv6.conf.all.accept_source_route = 0' >> /etc/sysctl.d/99-secure-network.conf
echo 'net.ipv4.tcp_syncookies = 1' >> /etc/sysctl.d/99-secure-network.conf
echo 'net.ipv4.conf.all.rp_filter = 1' >> /etc/sysctl.d/99-secure-network.conf

# Apply the changes
sysctl --system

# Reboot the system (optional)
echo "Rebooting the system to apply all changes..."
reboot
