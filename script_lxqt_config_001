#!/bin/bash

# Update the package list
sudo apt update
sudo apt upgrade -y

# Install the LXQt desktop environment without recommended packages
sudo apt install -y lxqt --no-install-recommends

# Install the LightDM display manager
sudo apt install -y lightdm

# Set LightDM as the default display manager, if prompted
# (if not prompted, you can set it manually later)

# Set the graphical target as the default
sudo systemctl set-default graphical.target

# Enable LightDM to start on boot
sudo systemctl enable lightdm

# Inform the user that the configuration is complete
echo "Configuration complete. Please restart the system to start in the graphical environment."

# Restart the system (uncomment the line below to restart automatically)
# sudo reboot
